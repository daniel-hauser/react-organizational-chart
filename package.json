{
  "name": "react-organizational-chart",
  "version": "2.2.1",
  "description": "Simple react hierarchy tree - any React children accepted for nodes",
  "author": "daniel-hauser",
  "license": "MIT",
  "homepage": "https://daniel-hauser.github.io/react-organizational-chart",
  "repository": "daniel-hauser/react-organizational-chart",
  "main": "dist/index.js",
  "source": "src/index.tsx",
  "module": "dist/index.module.js",
  "unpkg": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.module.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=16",
    "npm": ">=8"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "start": "tsdown --watch",
    "prepare": "npm run build",
    "prettier": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/bundle-size.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "preview-storybook": "vite preview --outDir storybook-static --port 6006 --strictPort"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5"
  },
  "peerDependencies": {
    "react": ">= 16.12.0",
    "react-dom": ">= 16.12.0"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": "0.9.1"
  },
  "devDependencies": {
    "@emotion/jest": "^11.14.2",
    "@playwright/test": "1.65.0",
    "@storybook/addon-docs": "~10.6.6",
    "@storybook/addon-links": "~10.6.6",
    "@storybook/react-vite": "~10.6.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "~10.6.6",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "prettier": {
    "printWidth": 80,
    "singleQuote": true
  },
  "keywords": [
    "react",
    "organizational",
    "organizational-chart",
    "react-organizational-chart",
    "org-chart",
    "react-org-chart",
    "tree",
    "family",
    "family-tree"
  ],
  "files": [
    "dist"
  ]
}
