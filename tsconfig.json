{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2018",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "include": ["src", ".storybook", "*.config.ts", "*.config.mts", "tests"],
  "exclude": ["node_modules", "build", "dist", "example"]
}
